-- Logic Execution
local hitboxEnabled = false
local hitboxSize = 10
local hitboxTransparency = 0.5
local targetPartName = "HumanoidRootPart"

sizeInput:GetPropertyChangedSignal("Text"):Connect(function()
	local num = tonumber(sizeInput.Text)
	if num and num >= 0 then
		hitboxSize = num
	end
end)

transInput:GetPropertyChangedSignal("Text"):Connect(function()
	local num = tonumber(transInput.Text)
	if num and num >= 0 and num <= 1 then
		hitboxTransparency = num
	end
end)

partInput:GetPropertyChangedSignal("Text"):Connect(function()
	if partInput.Text ~= "" then
		targetPartName = partInput.Text
	end
end)

toggleButton.MouseButton1Click:Connect(function()
	hitboxEnabled = not hitboxEnabled
	if hitboxEnabled then
		toggleButton.Text = "Hitbox: ON"
		toggleButton.TextColor3 = Color3.fromRGB(50, 200, 50)
	else
		toggleButton.Text = "Hitbox: OFF"
		toggleButton.TextColor3 = Color3.fromRGB(200, 50, 50)
		
		-- Reset all players hitboxes back to original state
		for _, otherPlayer in pairs(Players:GetPlayers()) do
			if otherPlayer ~= player and otherPlayer.Character then
				local part = otherPlayer.Character:FindFirstChild(targetPartName)
				if part and part:IsA("BasePart") then
					part.Size = Vector3.new(2, 2, 1)
					part.Transparency = 1
					part.CanCollide = true
				end
			end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if hitboxEnabled then
		for _, otherPlayer in pairs(Players:GetPlayers()) do
			if otherPlayer ~= player and otherPlayer.Character then
				local part = otherPlayer.Character:FindFirstChild(targetPartName)
				if part and part:IsA("BasePart") then
					part.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
					part.Transparency = hitboxTransparency
					part.CanCollide = false
				end
			end
		end
	end
end)
