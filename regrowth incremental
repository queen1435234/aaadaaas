local function formatMachineTitle(i)
    local name = (MachineData[i].Name[1] or "") .. " " .. (MachineData[i].Name[2] or "")
    local isUnlocked = (i <= Stats.MachineUnlocked.Value)
    if isUnlocked then
        return string.format("🟢 Machine %d: %s [UNLOCKED]", i, name)
    else
        return string.format("🔒 Machine %d: %s [LOCKED]", i, name)
    end
end

local function formatMachineDesc(i)
    local isUnlocked = (i <= Stats.MachineUnlocked.Value)
    if isUnlocked then
        local lvl = Stats:FindFirstChild("Machine" .. i .. "Level") and Stats["Machine" .. i .. "Level"].Value or 0
        local count = Stats:FindFirstChild("Machine" .. i) and Stats["Machine" .. i].Value or 0
        local maxLvl = getMaxLevel(i)
        local limit = MachineData[i].Limit or 5
        local nextUpCost = (lvl < maxLvl) and Suffix.Round(getMachineUpgradeCost(i, lvl)) or "MAXED"
        local nextCountCost = (count < limit) and Suffix.Round(getMoreMachinesCost(i, count)) or "MAXED"
        return string.format("Lvl %d/%d (Up: %s) • Owned: %d/%d (Add: %s)", lvl, maxLvl, nextUpCost, count, limit, nextCountCost)
    else
        local price = Suffix.Round(MachineData[i].MachinePrice or 0)
        local reqPart = math.floor((i + 3) / 4)
        local reqStage = math.floor((i - 1) / 4) + 1
        return string.format("Price: %s Energy • Needs Stage %d, Part %d", price, reqStage, reqPart)
    end
end

for i = 1, #MachineData do
