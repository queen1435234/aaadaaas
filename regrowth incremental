-- Background Update & Automation Loop
task.spawn(function()
    local lastInfoUpdate = 0
    while true do
        if typeof(STATE) == "table" and STATE.alive and not STATE.alive() then
            break
        end

        local energy = getEnergy()
        local unlocked = Stats.MachineUnlocked.Value
        local now = os.clock()

        -- Update Live Overview every ~0.5s
        if now - lastInfoUpdate > 0.5 then
            lastInfoUpdate = now
            pcall(function()
                StatusPara:SetDesc(string.format(
                    "Energy: %s\nUnlocked Machines: %d / %d\nStage: %d | Factory Part: %d",
                    Suffix.Round(energy),
                    unlocked,
                    #MachineData,
                    Stats.Stage.Value,
                    Stats.TycoonMachinePart.Value
                ))
                
                -- Update titles and descriptions in the Select Machines tab
                for i = 1, #MachineData do
                    if MachineToggles[i] then
                        MachineToggles[i]:SetTitle(formatMachineTitle(i))
                        MachineToggles[i]:SetDesc(formatMachineDesc(i))
                    end
                end
            end)
        end

        -- 1. Auto Unlock Next Machine (Money Checker verified)
        if Config.AutoUnlockMachines then
            local nextMachine = unlocked + 1
            if canUnlockMachine(nextMachine) then
                local unlockCost = getUnlockCost(nextMachine)
                if energy >= unlockCost then
                    Events.MachineUpgrade.UnlockMachine:FireServer(nextMachine)
                    energy = energy - unlockCost
                    task.wait(0.1)
                end
            end
        end

        -- 2. Auto Buy More Machines (for selected machines only, Money Checker verified)
        if Config.AutoBuyMoreMachines then
            for id = 1, unlocked do
                if Config.SelectedMachines[id] then
                    local countStat = Stats:FindFirstChild("Machine" .. id)
                    if countStat then
                        local currentCount = countStat.Value
                        local limit = MachineData[id].Limit or 5
                        if currentCount < limit then
                            local moreCost = getMoreMachinesCost(id, currentCount)
                            if energy >= moreCost then
                                Events.MachineUpgrade.MoreMachines:FireServer(id)
                                energy = energy - moreCost
                                task.wait(0.05)
                            end
                        end
                    end
                end
            end
        end

        -- 3. Auto Upgrade Levels (for selected machines only, Money Checker verified)
        if Config.AutoUpgradeLevels then
            for id = 1, unlocked do
                if Config.SelectedMachines[id] then
                    local lvlStat = Stats:FindFirstChild("Machine" .. id .. "Level")
                    if lvlStat then
                        local currentLvl = lvlStat.Value
                        local maxLvl = getMaxLevel(id)
                        if currentLvl < maxLvl then
                            local upCost = getMachineUpgradeCost(id, currentLvl)
                            if energy >= upCost then
                                if Config.UpgradeMax then
                                    Events.MachineUpgrade:FireServer(id, true)
                                else
                                    Events.MachineUpgrade:FireServer(id)
                                end
                                energy = energy - upCost
                                task.wait(0.05)
                            end
                        end
                    end
                end
            end
        end

        -- 4. Auto Board Upgrades (Money Checker verified)
        local boardToggles = {
            Furnace = Config.AutoFurnace,
            Pipes = Config.AutoPipes,
            Filtering = Config.AutoFiltering,
            Overclock = Config.AutoOverclock,
            Storage = Config.AutoStorage
        }

        for upgradeName, enabled in pairs(boardToggles) do
            if enabled then
                local cost, currentLvl, limit = getBoardUpgradeCost(upgradeName)
                if currentLvl < limit and energy >= cost then
                    Events.BuyMachineUpgrade:FireServer(upgradeName)
                    energy = energy - cost
                    task.wait(0.05)
                end
            end
        end

        task.wait(Config.Delay or 0.25)
    end
end)

