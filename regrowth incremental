-- Helper Formulas & Money Checker
local function getEnergy()
    local energyStat = Stats:FindFirstChild("Energy")
    return energyStat and energyStat.Value or 0
end

local function getMaxLevel(machineId)
    local baseMax = MachineData[machineId].MaxLevel or 100
    local treeBonus = Stats:FindFirstChild("TreeUpgrade16") and Stats.TreeUpgrade16.Value or 0
    return baseMax + 5 * treeBonus
end

local function getMachineUpgradeCost(machineId, currentLevel)
    local data = MachineData[machineId]
    if not data then return math.huge end
    return math.floor(data.UpgradePrice * (currentLevel / 2 + 1) * (1 + 0.165 * data.UpgradePriceScale) ^ currentLevel)
end

local function getMoreMachinesCost(machineId, currentCount)
    local data = MachineData[machineId]
    if not data then return math.huge end
    return math.floor(data.MachinePrice * (20 * data.UpgradePriceScale) ^ (currentCount + 1))
end

local function getUnlockCost(machineId)
    local data = MachineData[machineId]
    if not data then return math.huge end
    return data.MachinePrice or math.huge
end

local function canUnlockMachine(machineId)
    if machineId > #MachineData then return false end
    if Stats.MachineUnlocked.Value + 1 ~= machineId then return false end
    if Stats.TycoonMachinePart.Value < math.floor((machineId + 3) / 4) then return false end
    if Stats.Stage.Value < math.floor((machineId - 1) / 4) then return false end
    return true
end

local function getBoardUpgradeCost(upgradeName)
    for _, item in ipairs(MachineUpgradeData) do
        if item.UpgradeName == upgradeName then
            local stat = Stats:FindFirstChild(upgradeName .. "MachineUpgrade")
            local currentLvl = stat and stat.Value or 0
            if currentLvl >= item.Limit then
                return math.huge, currentLvl, item.Limit
            end
            local cost = math.floor(item.CostBase * (item.Factor ^ currentLvl))
            return cost, currentLvl, item.Limit
        end
    end
    return math.huge, 0, 0
end

